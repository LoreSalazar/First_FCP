{ Stiffeners_FPC.pas  -  Genera los stiffeners del FPC (Altium Designer 20)
  Mechanical 3 = Stiffener_PI_Bottom  (PI 0.15 mm, bajo los dedos del ZIF)
  Mechanical 4 = Stiffener_FR4_Bottom (FR4 0.4 mm, anillos en los 9 pares de postes)
  Ejecutar: File > Run Script... > Stiffeners_FPC.pas > CrearStiffeners
  Se puede deshacer con Ctrl+Z. }

Var
  HolesOK : Boolean;

Procedure SetupMechLayer(Board : IPCB_Board; Layer : TLayer; LName : String);
Var
  L : IPCB_LayerObject;
Begin
  Try
    L := Board.LayerStack_V7.LayerObject_V7[Layer];
    L.MechanicalLayerEnabled := True;
    L.Name := LName;
    L.IsDisplayed[Board] := True;
  Except
  End;
End;

Procedure AddStiffener(Board : IPCB_Board; Layer : TLayer; Outer, H1, H2 : IPCB_Contour; WithHoles : Boolean);
Var
  Region : IPCB_Region;
  Geo    : IPCB_GeometricPolygon;
Begin
  Region := PCBServer.PCBObjectFactory(eRegionObject, eNoDimension, eCreate_Default);
  Region.Layer := Layer;
  Region.SetOutlineContour(Outer);
  If WithHoles Then
  Begin
    Try
      Geo := PCBServer.PCBGeometricPolygonFactory;
      Geo.AddContourIsHole(Outer, False);
      Geo.AddContourIsHole(H1, True);
      Geo.AddContourIsHole(H2, True);
      Region.GeometricPolygon := Geo;
    Except
      HolesOK := False;
    End;
  End;
  Board.AddPCBObject(Region);
  PCBServer.SendMessageToRobots(Board.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, Region.I_ObjectAddress);
End;

Procedure AddNote(Board : IPCB_Board; Layer : TLayer; X, Y : Double; S : String);
Var
  T : IPCB_Text;
Begin
  T := PCBServer.PCBObjectFactory(eTextObject, eNoDimension, eCreate_Default);
  T.XLocation := MMsToCoord(X);
  T.YLocation := MMsToCoord(Y);
  T.Layer := Layer;
  T.Size := MMsToCoord(1.2);
  T.Width := MMsToCoord(0.15);
  T.Text := S;
  Board.AddPCBObject(T);
  PCBServer.SendMessageToRobots(Board.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, T.I_ObjectAddress);
End;

